# LiveKit Cloud Project Settings — get yours at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Deepgram Speech-to-Text API Key — get yours at https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Groq LLM API Key — get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Rime TTS API Key — get yours at https://app.rime.ai
RIME_API_KEY=your_rime_api_key_here

SUPABASE_URL=https://your_url.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
